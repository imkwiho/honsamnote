{
  "name": "ai-blog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/generate-indexnow-key-file.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:functions": "tsc --noEmit -p tsconfig.functions.json",
    "generate": "ts-node --project tsconfig.scripts.json scripts/generate-post.ts",
    "deploy": "npm run build && wrangler pages deploy out",
    "db:migrate:local": "wrangler d1 execute honsamnote-analytics --local --file=migrations/0001_create_analytics_tables.sql",
    "db:migrate:remote": "wrangler d1 execute honsamnote-analytics --remote --file=migrations/0001_create_analytics_tables.sql",
    "pages:dev": "npm run build && wrangler pages dev out --d1 ANALYTICS_DB=honsamnote-analytics --compatibility-date=2024-01-01"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@google/generative-ai": "^0.24.1",
    "@tailwindcss/typography": "^0.5.19",
    "firebase": "^12.14.0",
    "gray-matter": "^4.0.3",
    "next": "16.2.7",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.98.0"
  }
}
