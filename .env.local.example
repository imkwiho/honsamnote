# Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key

# Admin - 관리자 로그인/비밀번호 검증은 더 이상 클라이언트 코드에서 하지 않습니다.
# ADMIN_AUTH_HASH(Cloudflare 시크릿)만 필요합니다 — .dev.vars.example 참고.

# EmailJS — 뉴스레터 구독 알림 (guihol@naver.com 수신)
# 설정법: https://www.emailjs.com → 무료 계정 생성 → Service/Template 연결
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxxx
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# Site
NEXT_PUBLIC_SITE_URL=https://your-domain.pages.dev
NEXT_PUBLIC_SITE_NAME=1인 가구 생활백서

# Cloudflare Analytics (선택)
CLOUDFLARE_ANALYTICS_TOKEN=your_token

# ────────────────────────────────────────────────────────────────
# 방문자 통계(Cloudflare D1) 관련 환경변수는 이 파일이 아니라 .dev.vars.example
# 을 참고하세요. Next.js 빌드가 아니라 Cloudflare Pages Functions(functions/)가
# 읽는 값이라 NEXT_PUBLIC_* 이 아닌 별도 Cloudflare 시크릿/바인딩입니다.
# ────────────────────────────────────────────────────────────────
